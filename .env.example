# GROQ (IA)
GROQ_API_KEY=sua_chave_aqui

# STRIPE (adicionar depois)
STRIPE_SECRET_KEY=sk_test_ADICIONAR_DEPOIS
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_ADICIONAR_DEPOIS
STRIPE_PRICE_PRESENCA=price_ADICIONAR_DEPOIS
STRIPE_PRICE_LEGADO=price_ADICIONAR_DEPOIS
